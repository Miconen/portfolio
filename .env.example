# Contact form (required in production): a Resend API key with sending access to micorintala.com.
RESEND_API_KEY=
# Optional overrides for the contact form.
# CONTACT_TO=contact@micorintala.com
# CONTACT_FROM=Portfolio <form@micorintala.com>

# Recommended: any GitHub token (no scopes needed) to lift the 60 requests/hour anonymous limit.
GITHUB_TOKEN=

# Only for running the production build locally over plain http (form posts are CSRF-checked):
# ORIGIN=http://localhost:3000
